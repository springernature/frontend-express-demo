{
  "name": "frontend-techtest",
  "version": "0.0.0",
  "private": true,
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:img": "mkdir -p ./public/img && cp ./img/*.svg ./img/favicon/favicon.ico ./public/img/",
    "build:scss": "sass ./scss/style.scss ./public/css/style.css --style=expanded --source-map",
    "build:js": "rollup -c",
    "build": "npm-run-all --parallel build:*",
    "start": "node app",
    "start:dev": "npm-run-all --parallel dev:server dev:scss dev:js build:img",
    "dev:scss": "sass ./scss/style.scss ./public/css/style.css --style=expanded --source-map --watch",
    "dev:js": "rollup -c --watch",
    "dev:server": "node --watch --watch-path=app.js --watch-path=routes --watch-path=data --watch-path=views app.js",
    "test": "npx jest --verbose"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "express": "^5.1.0",
    "hbs": "^4.3.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.17.5",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "babel-jest": "30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.63.4",
    "sass": "^1.105.0"
  }
}
